  "plan": {
    "resources.model_provider_services.example": {
      "action": "create",
      "new_state": {
        "value": {
          "parent": "schemas/main.synthetic_ai",
          "model_provider_service_id": "example_provider",
          "comment": "Constructed source-backed example; not deployed",
          "config": {
            "provider_type": "EXTERNAL_MODEL_PROVIDER_TYPE_CUSTOM",
            "custom": {
              "direct": {
                "base_url": "https://provider.example.invalid/v1"
              }
            },
            "targets": [
              {
                "model": "example-model",
                "native_api_types": [
                  "openai/v1/chat/completions"
                ]
              }
            ]
          }
        }
      }
    },
    "resources.model_provider_services.example.grants": {
      "depends_on": [
