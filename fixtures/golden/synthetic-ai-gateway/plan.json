      "new_state": {
        "value": {
          "securable_type": "model_provider_service",
          "full_name": "",
          "__embed__": [
            {
              "principal": "synthetic_reviewers",
              "privileges": [
                "APPLY_TAG"
              ]
            }
          ]
        },
        "vars": {
          "full_name": "${resources.model_provider_services.example.id}"
        }
      }
    },
    "resources.model_provider_services.bedrock": {
      "action": "create",
      "new_state": {
        "value": {
          "parent": "schemas/main.synthetic_ai",
          "model_provider_service_id": "bedrock_provider",
          "comment": "Constructed UC service-credential reference; not deployed",
          "config": {
            "provider_type": "EXTERNAL_MODEL_PROVIDER_TYPE_AMAZON_BEDROCK",
            "amazon_bedrock": {
              "direct": {
                "region": "us-east-1",
                "service_credential": {
