    "resources.model_services.example": {
      "action": "create",
      "new_state": {
        "value": {
          "parent": "schemas/main.synthetic_ai",
          "model_service_id": "example_router",
          "comment": "Constructed primary and fallback routing example; not deployed",
          "config": {
            "routing": {
              "destinations": [
                {
                  "name": "external_primary",
                  "destination_type": "DESTINATION_TYPE_EXTERNAL_FOUNDATION_MODEL",
                  "traffic_percentage": 100,
                  "external_model_config": {
                    "model_provider_service": "model-provider-services/main.synthetic_ai.example_provider",
                    "target": {
                      "model": "example-model",
                      "native_api_types": [
                        "openai/v1/chat/completions"
                      ]
                    }
                  }
                }
              ],
              "fallback": {
                "destinations": [
                  {
                    "name": "foundation_fallback",
                    "destination_type": "DESTINATION_TYPE_PAY_PER_TOKEN_FOUNDATION_MODEL",
                    "pay_per_token_config": {
                      "model": "models/system.ai.example_foundation_model"
                    }
                  },
                  {
                    "name": "provisioned_fallback",
                    "destination_type": "DESTINATION_TYPE_PROVISIONED_THROUGHPUT_FOUNDATION_MODEL",
                    "provisioned_throughput_config": {
                      "model_serving_endpoint": "serving-endpoints/example_endpoint"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "resources.model_services.example.grants": {
      "depends_on": [
        {
          "node": "resources.model_services.example",
          "label": "${resources.model_services.example.id}"
        }
      ],
      "action": "create",
      "new_state": {
        "value": {
          "securable_type": "model_service",
          "full_name": "",
          "__embed__": [
            {
              "principal": "synthetic_reviewers",
              "privileges": [
                "APPLY_TAG"
              ]
            },
            {
              "principal": "synthetic_operators",
              "privileges": [
                "EXECUTE"
              ]
            }
          ]
        },
        "vars": {
          "full_name": "${resources.model_services.example.id}"
        }
      }
    },
