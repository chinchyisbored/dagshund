{
  "description": "Shared hand-authored plan vectors for semantic job_runs effect rendering in Python and TypeScript.",
  "cases": [
    {
      "name": "completed_success_skip",
      "plan": {
        "resources.jobs.completed": {
          "action": "skip",
          "remote_state": { "job_id": 101 }
        },
        "resources.job_runs.completed": {
          "depends_on": [{ "node": "resources.jobs.completed" }],
          "action": "skip",
          "remote_state": {
            "job_id": 101,
            "result_state": "SUCCESS",
            "state": {
              "life_cycle_state": "TERMINATED",
              "result_state": "SUCCESS"
            }
          },
          "changes": {
            "result_state": {
              "action": "skip",
              "reason": "remote_already_set",
              "new": "SUCCESS",
              "remote": "SUCCESS"
            }
          }
        }
      },
      "effectKey": "resources.job_runs.completed",
      "expected": {
        "kind": "completed-success",
        "wording": "already ran successfully",
        "outcome": null,
        "stateMessage": null,
        "firesOnDeploy": false,
        "badgeVisible": true,
        "visibleChangeKeys": []
      }
    },
    {
