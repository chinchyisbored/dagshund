{
  "name": "dagshund",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tailwindcss -i src/styles/index.css -o src/styles/output.css && (tailwindcss -i src/styles/index.css -o src/styles/output.css --watch & bun --hot src/index.ts)",
    "build:css": "tailwindcss -i src/styles/index.css -o src/styles/output.css --minify",
    "build:css:watch": "tailwindcss -i src/styles/index.css -o src/styles/output.css --watch",
    "build": "rm -rf dist && bun run build:css && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "build:template": "bun scripts/build-template.ts",
    "lint": "biome check --fix src/ tests/",
    "format:check": "biome format src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "12.11.5",
    "elkjs": "0.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@happy-dom/global-registrator": "20.11.6",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "ws": "8.21.0"
  }
}
